{
    "manifest_version": 3,
    "name": "get it done",
    "version": "1.0",
    "description": "A productivity extension with task management, permissions timer, and focus features.",
    "permissions": ["storage", "alarms", "notifications", "tabs", "activeTab"],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html",
      "default_icon": "icon.jpeg"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
      }
    ]
  }
  